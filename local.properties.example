# Copy this file to `local.properties` (git-ignored) and fill in real values.

# UDID of the Android TV device. For a network-attached box use ip:port.
udid=192.168.50.207:5555

environment=dev
appiumHost=127.0.0.1
appiumPort=4732
manageAppium=false
# Attach screen recording to Allure for ALL tests (failures always attach video).
videoRecord=false

# Premium staging test account used by the API sign-in precondition.
# The TV welcome gate requires a premium account. Never commit real credentials.
tvEmail=
tvPassword=

# Server-list API v7 (encrypted). AES key used to decode the response. Never commit.
serverListKey=
# Optional overrides (defaults shown).
region=UA
serverlistUrl=https://dev-api.mobilejump.mobi

# ---- Testomat.io reporting (see TESTOMATIO.md) ----
# The switch: true  -> a run is created in Testomat.io and every result is reported into it
#             false -> nothing is sent at all (not a single request)
# -Dtestomatio=true on the command line overrides this file.
testomatio=false

# Close the AUTOMATED half of the run when the suite ends, so the run can be finished in the UI.
# Safe here: the TV suite runs in one JVM. (In the phone project two device suites share one run,
# there this must stay false.) The run itself is still closed by a human — "Finish Run" after review.
testomatioFinishRun=true

# Title of the created run. Leave empty for "<suite> — dd.MM.yyyy HH:mm".
testomatioRunTitle=

# Project Reporting API key (Settings -> Project). Never commit a real key.
testomatioApiKey=
